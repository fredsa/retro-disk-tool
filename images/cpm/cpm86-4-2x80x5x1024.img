/*
//This report is as simple as they come.  It uses olny one
//datafile for its output.  Except for these comments this report could
//have been produced by the QUERY program.


OUTFILE 				//direct the output to the
					//printer (default)
OPEN VENDOR INDEX.1			//open the vendor file buffering
					//index 1, vendor name

REPORT VENDOR BY INDEX.1		//print each vendor in the 
					//database in vendor name order
SECTION HEADER
  OUTPUT HEADER 			//print the page header information

SECTION BODY
  PRINT VENDOR.RECNUM			//system assigned number
  PRINT VENDOR.VENDOR
  PRINT VENDOR.TERMS
  PRINT VENDOR.CREDIT_LIMIT
  PRINT VENDOR.CREDIT_USED
  PRINT VENDOR.PURCHASES
  PRINT VENDOR.LAST_PURCHASE
  OUTPUT BODY				//print the page
REPORTEND
ABORT

