     ALU -  now includes hardware math, paralleY-D/2)/(((Y-D/2)^2)+((Z-H)^2)))*(((L-X)/RAD)+(X/RADXO))
280 BZB=((X-L)/(((X-L)^2)+((Z-H)^2)))*(((D/2-Y)/RAD)+((D/2+Y)/RADY))
290 BZC=((Y+D/2)/(((Y+D/2)^2)+((Z-H)^2)))*(((L-X)/RADY)+(X/RADXOY))
300 BZD=((Y-D/2)/(((Y-D/2)^2)+((Z+H)^2)))*(((L-X)/RADZ)+(X/RADXOZ))
310 BZE=((X-L)/(((X-L)^2)+((Z+H)^2)))*(((D/2-Y)/RADZ)+((D/2+Y)/RADYZ))
320 BZF=((Y+D/2)/(((Y+D/2)^2)+((Z+H)^2)))*(((L-X)/RADYZ)+(X/RADXOYZ))
330 BZ=PRE*(BZA+BZB-BZC-BZD-BZE+BZF)
340 BMAG= SQR ((BX^2)+(BY^2)+(BZ^2))
350 PRINT BXA,BXB
360 PRINT BYA,BYB,BYC,BYD
370 PRINT BZA,BZB,BZC,BZD,BZE,BZF
380 PRINT BX,BY,BZ
390 PRINT BMAG
