ли‹и‘ БРШsё&Pи+//open the system file

	DISPLAY SYSFILE.COMPANY_NAME TO DATE.1
	DISPLAY SYSFILE.DATE TO DATE.2

	GOSUB DISP_DAY				//display the day of the week

	ACCEPT DATE.1	TO SYSFILE.COMPANY_NAME   //let user change name
	
AGAIN:	ACCEPT DATE.2	TO SYSFILE.DATE 	 //let user change date

	GOSUB DISP_DAY				//display the new day

	DISPLAY 'IS THIS DATE CORRECT?' TO DATE.4  //save it?
	DISPLAY 'Y' TO DATE.5			   //set up a default
	ACCEPT DATE.5
	IF DATE.5 NE 'Y' BEGIN			//bad date?
	  BLANKFORM DATE.3 THRU DATE.5		//clear windows
	  GOTO AGAIN				//and try it again
	  END

	SAVE SYSFILE				//save the record
	ABORT					//done!

DISP_DAY:
//This subroutine calculates the day of the week by taking the mod
//of the julian date entered in the system file.

	MOVE (SYSFILE.DATE/7) TO STUF.1
//divide by seven and move the integer portion to a non-displayed window.

	MOVE (SYSFILE.DATE-(STUF.1*7)) TO WINDOWINDEX
//calculate then whole number remainder (mod) and move it to our window
//index.  The ca/DATE
DATA ACCESS CORPORATION 				     SYSTEM FILE
========================================================================



	COMPANY NAME: ________________________________________


	TODAY'S DATE: __/__/__    _________

	________________________ _

/HELP1	HELP
			 SYSTEM DATE HELP SCREEN
==============================================================================

This screen will enable the user to input and maintain the system date file
in the Dataflex demonstration application.  This is a standard "FLEX" screen
and as such uses the standard "Flex keys".

The system will display the existing date in the record as it is loaded.  The
operator can change the data or leave it unchanged.

For more help on the individual fields press the help key again, otherwise 
press any other key to return to the system file screen.
/HELP2	HELP
		       SYSTEM DATE HELP SCREEN TWO
==============================================================================

COMPANY NAME : Enter your companlculated number will be between 0 and 6 
//(SUNDAY THRU SATURDAY).  The answer will be the offset from window
//one of the days screen.

	DISPLAY DAYS.1& TO DATE.3
//use indexed window addressing to display the day of the week to the user.
	RETURN

KEYPROC KEY.FIELD
	BACKFIELD		//back up one window
	RETURN
KEYPROC KEY.ESCAPE
	ABORT			// go away and dont save record

KEYPROC KEY.HELP		//set up confiuration for help screens
	HELP			//show the help screen
	ENTAGAIN		//back to same window
	RETURN			//return to accept
confiuration for help screens
	HELP			//show the help screen
	ENTAGAIN		//back to same window
	RETUAL 
  SUBTOTAL BODY.4		//subtotal will take the accumulator
				//for any numeric window and print
				//it in another window. 
				//print the total purchases for all
  OUTPUT TOTAL			//customers in the database
REPORTEND
ABORT


