//   ENTER & REPORT DEF'S

#REPLACE LINECOUNT |VI10
#REPLACE PAGECOUNT |VI11
#REPLACE PAGEEND |VI25
#REPLACE PAGEFEED |VI26
#SET D$ 80
#SET P$ 0
#REPLACE AUTOFIND $C000
#REPLACE FINDREQ  $C001
#REPLACE NOPUT	  $C002
#REPLACE NOENTER  $C003
#REPLACE SKIPFOUND $C004
#REPLACE RETAINALL $C005
