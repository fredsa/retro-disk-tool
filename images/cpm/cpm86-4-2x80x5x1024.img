80 MU = 4* 3.141592654#*.0000001
90 PI=3.141592654#
100 PRE=(MU*I)/(4*PI)
110 RAD= SQR (((X-L)^2)+((Y-D/2)^2)+((Z-H)^2))
120 RADY= SQR (((X-L)^2)+((Y+D/2)^2)+((Z-H)^2))
130 RADZ= SQR (((X-L)^2)+((Y-D/2)^2)+((Z+H)^2))
140 RADYZ= SQR (((X-L)^2)+((Y+D/2)^2)+((Z+H)^2))
150 RADXO= SQR ((X^2)+((Y-D/2)^2)+((Z-H)^2))
160 RADXOY= SQR ((X^2)+((Y+D/2)^2)+((Z-H)^2))
170 RADXOZ= SQR ((X^2)+((Y-D/2)^2)+((Z+H)^2))
180 RADXOYZ= SQR ((X^2)+((Y+D/2)^2)+((Z+H)^2))
190 BXA=((Z+H)/(((X-L)^2)+((Z+H)^2)))*(((D/2-Y)/RADZ)+((D/2+Y)/RADYZ))
200 BXB=((Z-H)/(((X-L)^2)+((Z-H)^2)))*(((D/2-Y)/RAD)+((D/2+Y)/RADY))
210 BX=PRE*(BXA-BXB)
220 BYA=((Z+H)/(((Y-D/2)^2)+((Z+H)^2)))*(((L-X)/RADZ)+(X/RADXOZ))
230 BYB=((Z+H)/(((Y+D/2)^2)+((Z+H)^2)))*(((L-X)/RADYZ)+(X/RADXOYZ))
240 BYC=((Z-H)/(((Y-D/2)^2)+((Z-H)^2)))*(((L-X)/RAD)+(X/RADXO))
250 BYD=((Z-H)/(((Y+D/2)^2)+((Z-H)^2)))*(((L-X)/RADY)+(X/RADXOY))
260 BY=PRE*(BYA-BYB-BYC+BYD)
270 BZA=((rу  froн  basiг Ќ
buildinз  blockу  sucи  aу  memories¬   ALU's¬   busses,..®   Caо Ќ
construct computers from calculators to Cray 2's.

2.  Early computer: 1946 design: Von Neumann Computer
    draw on board picture from page 7


3.  MAR, MDR, adder/shifter, accum, control unit, i/o, 

4.  to write, MDR <- data; MAR <- address; WRITE;
5.  to read,  MAR <- address; READ; causes MDR <- [MAR]
6.  instruction word,  operand & address 40 bits:  |address (12) | opcode (8)|
7.  <- is same as :=       see page 10  
8.  LOAD X     Acc <= MEMORY[X]
9.  STORE Y    MEMORY[Y] <- Acc
10.  show sequence:   1: read instruction into I reg (address is in P reg)
                      2: increment P reg
                      3: decode opcode  (one line per instruction type)
                      4: perform instruction  ie. MDR <- data; MAR <- addr; etc
                      5: loop to 1
