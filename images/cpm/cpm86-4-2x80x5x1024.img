#REPLACE MENU.QB1 |FS49,32
#REPLACE MENU.QA2 |FS49,33
#REPLACE MENU.QB2 |F files, inventory
//and inventory transactions (items).  Two levels of break points are
//used to show all parts sold by vendor and then by part_id.

	OPEN INVT
	OPEN ITEMS INDEX.2	//open the items file and buffer index 2
	OUTFILE 		//direct the output to the printer (default)

	REPORT ITEMS BY INDEX.2 BREAK ITEMS.VENDOR ITEMS.PART_ID

//this report will print all inventory transactions subtotaled by
//vendor and then by inventory part

SECTION HEADER
	OUTPUT HEADER		//print the header at the top of
				//all pages of the report

SECTION SUBHEADER2		//this section will be executed
	PRINT INVT.VENDOR	//when the vendor id changes
	PRINT INVT.VENDOR_PART_ID
	PRINT INVT.DESCRIPTION
	PRINT INVT.PART_ID
	PRINT INVT.QUANTITY
	PRINT INVT.LIST_PRICE
	OUTPUT SUBHEADER2
SECTION BODY			//print for each inventory part
	PRINT ITEMS.QUANTITY
	PRINT ITEMS.INVOICE
	PRINT ITEMS.PRICE
	PRINT ITEMS.AMOUNT
	PRINT ITEMS.COST
	PRINT (ITEMS.AMOUNT-ITEMS.COST)  //calculate and print the profit
	OUTPUT S49,34
#REPLACE MENU.QA3 |FS49,35
#REPLACE MENU.QB3 |FS49,36
#REPLACE MENU.QA4 |FS49,37
#REPLACE MENU.QB4 |FS49,38
#REPLACE MENU.QA5 |FS49,39
#REPLACE MENU.QB5 |FS49,40
#REPLACE MENU.QA6 |FS49,41
#REPLACE MENU.QB6 |FS49,42
.QB4 |FS49,38
#REPLACE, abort.

KEYPROC KEY.USER	// Define action of user defined key
	OUTPUT FORM	// Output form to list 
	ENTAGAIN	// Return to same window
	RETURN
.USER	// Define action of user defined key
	OUTPUT FORM	// Output form to list 
	ENTAGAIN	// Return to RN			//return to accept
confiuration for help screens
	HELP			//show the help screen
	ENTAGAIN		//back to same window
	RETUAL 
  SUBTOTAL BODY.4		//subtotal will take the accumulator
				//for any numeric window and print
				//it in another window. 
				//print the total purchases for all
  OUTPUT TOTAL			//customers in the database
REPORTEND
ABORT


another windowцбЉђµ␀Бў“лЭ “Љ’·␀€‡XЂыu<v°PиЌл “‹€G-й!яи*ьўЗ]Г␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀BODY
SECTION SUBTOTAL2		//for each invt part print the accumulated:
	SUBTOTAL BODY.1 	//qty sold
	SUBTOTAL BODY.4 	//amount
	SUBTOTAL BODY.5 	//cost
	SUBTOTAL BODY.6 	//profit
	OUTPUT SUBTOTAL2
SECTION SUBTOTAL1			//for each vendor print
	SUBTOTAL SUBTOTAL2.2		//total amount
	SUBTOTAL SUBTOTAL2.3		//total cost
	SUBTOTAL SUBTOTAL2.4		//total profit 
	OUTPUT SUBTOTAL1
SECTION TOTAL				//grand totals for this report:
	SUBTOTAL SUBTOTAL1.1		//amount
	SUBTOTAL SUBTOTAL1.2		//cost
	SUBTOTAL SUBTOTAL1.3		//profit
	OUTPUT TOTAL
REPORTEND
ABORT

OTAL SUBTOTAL1.1		//amount
	SUBTOTAL SUBTOTAL1.2		//cost
	SUBTOTAL SUBTOTAUB CLEAR
