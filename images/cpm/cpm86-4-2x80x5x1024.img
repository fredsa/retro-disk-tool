60 INPUT "ENTER H,L,D : ",H,L,D
70 INPUT "ENTER I : ",I
80 MU = 4* 3.141592654#*.0000001
90 PI=3.141592654#
100 PRE=(MU*I)/(4*PI)
110 RAD= SQR (((X-L)^2)+((Y-D/2)^2)+((Z-H)^2))
120 RADY= SQR (((X-L)^2)+((Y+D/2)^2)+((Z-H)^2))
130 RADXO= SQR ((X^2)+((Y-D/2)^2)+((Z-H)^2))
140 RADXOY= SQR ((X^2)+((Y+D/2)^2)+((Z-H)^2))
160 BXB=((Z-H)/(((X-L)^2)+((Z-H)^2)))*(((D/2-Y)/RAD)+((D/2+Y)/RADY))
170 BX=PRE*(-BXB)
200 BYC=((Z-H)/(((Y-D/2)^2)+((Z-H)^2)))*(((L-X)/RAD)+(X/RADXO))
210 BYD=((Z-H)/(((Y+D/2)^2)+((Z-H)^2)))*(((L-X)/RADY)+(X/RADXOY))
220 BY=PRE*(-BYC+BYD)
230 BZA=((Y-D/2)/(((Y-D/2)^2)+((Z-H)^2)))*(((L-X)/RAD)+(X/RADXO))
240 BZB=((X-L)/(((X-L)^2)+((Z-H)^2)))*(((D/2-Y)/RAD)+((D/2+Y)/RADY))
250 BZC=((Y+D/2)/(((Y+D/2)^2)+((Z-H)^2)))*(((L-X)/RADY)+(X/RADXOY))
290 BZ=PRE*(BZA+BZB-BZC)
300 BMAG= SQR ((BX^2)+(BY^2)+(BZ^2))
310 PRINT BX
320 PRINT BY
330 PRINT BZ
340 PRINT BMAG
350 INPUT "ANOTHER RUN? ",B$
360 IF B$="Y" THEN GOTO 50 ELSE GOTO 370
