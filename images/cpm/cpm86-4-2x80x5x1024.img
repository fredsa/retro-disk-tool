#REPLACE MENU.AC5 |FS49,17
#REPLACE MENU.PW5 |FS49,18
#REPLACE MENU.PR6 |FS49,19
#REPLACE MENU.AC6 |FS49,20
#REPLACE MENU.PW6 |FS49,21
#REPLACE MENU.PR7 |FS49,22
#REPLACE MENU.AC7 |FS49,23
#REPLACE MENU.PW7 |FS49,24
#REPLACE MENU.PR8 |FS49,25
#REPLACE MENU.AC8 |FS49,26
#REPLACE MENU.PW8 |FS49,27
#REPLACE MENU.PR9 |FS49,28
#REPLACE MENU.AC9 |FS49,29
#REPLACE MENU.PW9 |FS49,30
