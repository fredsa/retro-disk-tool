[FINDERR] BEGIN
	    DISPLAY "THIS RECORD NUMBER DOES NOT EXIST, DO YOU WISH TO CREATE A NEW RECORD" TO FORM.4
	    FORMAT FORM.5			  {CAPSLOCK,CHECK="Y,N"}  
	    DISPLAY 'Y' TO FORM.5	//set up a default entry in window 5
	    ACCEPT FORM.5
	    IF FORM.5 EQ "N" GOTO REFRESH      

	    MOVE FORM.2 TO FLEXERRS.ERROR_DESCR //must move error fields to
	    MOVE FORM.3 TO FLEXERRS.NOTE	//record buffe␀␀Е7␀␀␀␀␀␀␀␀‡␀␀␀␀␀␀␀␀␀C␀7␀␀␀␀␀У ␀"Ф-•␀R␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Щgs␀!Щ€ћ␀xЫ†0␀~Ь.*␀hЭ'7␀<ЮЃ!␀sЫЂE␀Ыg␀vЬцk␀mЭ…r␀'г&v␀␀␀␀␀␀␀␀␀␀␀␀s screen.

	DISPLAY DAYS.1& TO DATE.3
//use indexed window addressing to display the day of the week to the user.
	RETURN

KEYPROC KEY.FIELD
	BACKFIELD		//back up one window
	RETURN
KEYPROC KEY.ESCAPE
	ABORT			// go away and dont save record

KEYPROC KEY.HELP		//set up confiuration for help screens
	HELP			//show the help screen
	ENTAGAIN		//back to same window
	RETURN			//return to accept
confiuration for help screens
